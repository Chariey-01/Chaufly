# ---------------------------------------------------------------------------
# Chaufly / iFinder MVP configuration
# Copy to .env and fill in real values.
# ---------------------------------------------------------------------------

APP_NAME=iFinder
ENVIRONMENT=development
BASE_URL=http://localhost:8000
PUBLIC_TRACKING_BASE=http://localhost:8000/track

# SQLite for the hackathon; swap for postgresql+psycopg://user:pass@host/db in prod
DATABASE_URL=sqlite:///./ifinder.db

# --- Africa's Talking -------------------------------------------------------
# Leave AT_ENABLED=false to use the console fallback sender (no SMS actually sent).
AT_ENABLED=false
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=iFinder
AT_SMS_URL=https://api.africastalking.com/version1/messaging
AT_VOICE_URL=https://voice.africastalking.com/call

# --- Pricing ----------------------------------------------------------------
FARE_BASE=300
FARE_PER_KM=65
QUOTE_TTL_SECONDS=300
# Nairobi CBD average moving speed used for trip duration estimates
AVG_SPEED_KMH=21.25
# Driver approach speed used for pickup ETA estimates
APPROACH_SPEED_KMH=15.0

# --- M-Pesa Daraja (optional for MVP) ---------------------------------------
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.ngrok.app/api/mpesa/callback

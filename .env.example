# Africa's Talking sandbox credentials. Never commit the real values.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SMS_SENDER_ID=
# Required by Africa's Talking Voice before voice alerts can be attempted.
AT_VOICE_FROM=
# Configure this public HTTPS endpoint for the Voice number in the AT dashboard.
AT_VOICE_CALLBACK_URL=
# Comma-separated operations contacts for SOS notifications (optional).
OPERATIONS_ALERT_RECIPIENTS=

# Set to openrouteservice to enable real geocoding and driving directions.
ROUTING_PROVIDER=unconfigured
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# Fare formula: max(FARE_MINIMUM_KES, FARE_BASE_KES + distance_km * FARE_PER_KM_KES)
FARE_BASE_KES=300
FARE_MINIMUM_KES=300
FARE_PER_KM_KES=80
# DATABASE_URL defaults to sqlite:///chaufly.db
DATABASE_URL=sqlite:///chaufly.db
